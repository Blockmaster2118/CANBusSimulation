 SG_ Accel_Y : 32|16@1- (0.001,0) [-16|16] "g" VCU
 SG_ Accel_Z : 48|16@1- (0.001,0) [-16|16] "g" VCU

BO_ 3 PowertrainRotationalSpeed: 8 Motor
 SG_ Powertrain_RPM_Raw : 0|16@1+ (1,0) [0|65535] "rpm" VCU

BO_ 4 RearWheelSpeed: 8 Rear
 SG_ Rear_Speed_kmh : 0|16@1+ (0.1,0) [0|300] "km/h" VCU

BO_ 5 FrontWheelSpeed: 8 Front
 SG_ Front_Speed_kmh : 0|16@1+ (0.1,0) [0|300] "km/h" VCU

BO_ 6 BrakePressure: 8 BrakeSensors
 SG_ Front_Brake_Pressure_Raw : 0|16@1+ (1,0) [0|65535] "raw" VCU
 SG_ Rear_Brake_Pressure_Raw : 16|16@1+ (1,0) [0|65535] "raw" VCU

BO_ 7 CoolingTemp: 8 Radiator
 SG_ Coolant_In_C : 0|16@1- (0.1,0) [-40|150] "degC" VCU
 SG_ Coolant_Out_C : 16|16@1- (0.1,0) [-40|150] "degC" VCU

BO_ 8 MotorTemp: 8 Motor
 SG_ Motor_Temp_C : 0|16@1- (0.1,0) [-40|200] "degC" VCU

BO_ 9 InverterTemp: 8 Inverter
 SG_ Inverter_Temp_C : 0|16@1- (0.1,0) [-40|200] "degC" VCU

BO_ 10 RadiatorTemp: 8 Radiator
