BO_ 14 CoolantPumpFlow: 8 Radiator
 SG_ Coolant_Flow_Raw : 0|16@1+ (1,0) [0|65535] "raw" VCU

BO_ 15 IndividualBatteryTemp: 8 Temperature
 SG_ Individual_Batt_Temp_Raw : 0|16@1- (1,0) [-32768|32767] "raw" VCU

BO_ 16 BatteryVoltage: 8 BMS
 SG_ Pack_Voltage_V : 0|16@1+ (0.1,0) [0|500] "V" VCU

BO_ 17 BatteryCurrent: 8 BMS
 SG_ Pack_Current_A : 0|16@1- (0.1,0) [-500|500] "A" VCU

